# Required only when NEXT_PUBLIC_TTEEKA_APP_MODE=live.
NEXT_PUBLIC_TTEEKA_API_BASE_URL=http://localhost:3000/api/v1
# Required in live mode until authenticated membership discovery is exposed by the API.
NEXT_PUBLIC_TTEEKA_MERCHANT_ID=
