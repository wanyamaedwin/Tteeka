generator client {
  provider     = "prisma-client"
  output       = "../packages/database/src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("merchant_status")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MerchantMembershipStatus {
  ACTIVE
  DISABLED

  @@map("merchant_membership_status")
}

enum PermissionStatus {
  ACTIVE
  DEPRECATED

  @@map("permission_status")
}

enum RoleStatus {
  ACTIVE
  DISABLED

  @@map("role_status")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("product_status")
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("product_variant_status")
}

enum InventoryState {
  AVAILABLE

  @@map("inventory_state")
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT

  @@map("inventory_movement_type")
}

enum StockHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED

  @@map("stock_hold_status")
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED

  @@map("customer_status")
}

enum DeliveryLocationStatus {
  ACTIVE
  ARCHIVED

  @@map("delivery_location_status")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  COMPLETED
  ABANDONED
  CANCELLED

  @@map("order_status")
}

model Merchant {
  id          String         @id(map: "merchants_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  displayName String         @map("display_name") @db.VarChar(160)
  legalName   String?        @map("legal_name") @db.VarChar(200)
  phoneE164   String?        @map("phone_e164") @db.VarChar(16)
  email       String?        @db.VarChar(320)
  currency    String         @default("UGX") @db.Char(3)
  timezone    String         @default("Africa/Kampala") @db.VarChar(64)
  status      MerchantStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships            MerchantMembership[]
  roles                  Role[]
  products               Product[]
  inventoryBalances      InventoryBalance[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  stockHolds             StockHold[]
  customers              Customer[]
  deliveryLocations      DeliveryLocation[]
  orders                 Order[]
  orderItems             OrderItem[]

  @@index([status], map: "merchants_status_idx")
  @@map("merchants")
}

model Customer {
  id         String         @id(map: "customers_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId String         @map("merchant_id") @db.Uuid
  name       String?        @db.VarChar(160)
  phone      String         @db.VarChar(13)
  status     CustomerStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant          Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customers_merchant_id_fkey")
  deliveryLocations DeliveryLocation[]
  orders            Order[]

  @@unique([merchantId, id], map: "customers_merchant_id_id_key")
  @@unique([merchantId, phone], map: "customers_merchant_id_phone_key")
  @@index([merchantId, status], map: "customers_merchant_id_status_idx")
  @@index([merchantId, name], map: "customers_merchant_id_name_idx")
  @@map("customers")
}

model DeliveryLocation {
  id           String                 @id(map: "delivery_locations_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId   String                 @map("merchant_id") @db.Uuid
  customerId   String                 @map("customer_id") @db.Uuid
  area         String                 @db.VarChar(120)
  landmark     String                 @db.VarChar(240)
  phone        String                 @db.VarChar(13)
  instructions String?                @db.VarChar(500)
  mapPinUrl    String?                @map("map_pin_url") @db.VarChar(2048)
  status       DeliveryLocationStatus @default(ACTIVE)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "delivery_locations_merchant_id_fkey")
  customer Customer @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Cascade, map: "delivery_locations_merchant_id_customer_id_fkey")
  orders   Order[]

  @@unique([merchantId, id], map: "delivery_locations_merchant_id_id_key")
  @@unique([merchantId, customerId, id], map: "delivery_locations_merchant_customer_id_key")
  @@index([merchantId, customerId, status], map: "delivery_locations_merchant_customer_status_idx")
  @@index([merchantId, customerId, createdAt, id], map: "delivery_locations_merchant_customer_created_id_idx")
  @@map("delivery_locations")
}

model Product {
  id          String        @id(map: "products_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId  String        @map("merchant_id") @db.Uuid
  name        String        @db.VarChar(160)
  description String?       @db.VarChar(2000)
  category    String?       @db.VarChar(120)
  brand       String?       @db.VarChar(120)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "products_merchant_id_fkey")
  variants ProductVariant[]

  @@unique([merchantId, id], map: "products_merchant_id_id_key")
  @@index([merchantId, status], map: "products_merchant_id_status_idx")
  @@index([merchantId, name], map: "products_merchant_id_name_idx")
  @@index([merchantId, category], map: "products_merchant_id_category_idx")
  @@index([merchantId, brand], map: "products_merchant_id_brand_idx")
  @@map("products")
}

model ProductVariant {
  id             String               @id(map: "product_variants_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId     String               @map("merchant_id") @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  sku            String               @db.VarChar(64)
  barcode        String?              @db.VarChar(64)
  size           String?              @db.VarChar(80)
  colour         String?              @db.VarChar(80)
  status         ProductVariantStatus @default(INACTIVE)
  sellingPrice   BigInt?              @map("selling_price")
  costPrice      BigInt?              @map("cost_price")
  priceCurrency  String?              @map("price_currency") @db.Char(3)
  priceUpdatedAt DateTime?            @map("price_updated_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  product                Product                @relation(fields: [merchantId, productId], references: [merchantId, id], onDelete: Restrict, onUpdate: Cascade, map: "product_variants_merchant_id_product_id_fkey")
  priceHistory           VariantPriceHistory[]
  inventoryBalances      InventoryBalance[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  stockHolds             StockHold[]
  orderItems             OrderItem[]

  @@unique([merchantId, id], map: "product_variants_merchant_id_id_key")
  @@unique([merchantId, sku], map: "product_variants_merchant_id_sku_key")
  @@unique([merchantId, barcode], map: "product_variants_merchant_id_barcode_key")
  @@index([merchantId, productId, sku, id], map: "product_variants_merchant_id_product_id_sku_id_idx")
  @@index([merchantId, productId, status, sku, id], map: "product_variants_merchant_id_product_id_status_sku_id_idx")
  @@map("product_variants")
}

model Order {
  id                           String      @id(map: "orders_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId                   String      @map("merchant_id") @db.Uuid
  customerId                   String      @map("customer_id") @db.Uuid
  status                       OrderStatus @default(DRAFT)
  customerNameSnapshot         String?     @map("customer_name_snapshot") @db.VarChar(160)
  customerPhoneSnapshot        String      @map("customer_phone_snapshot") @db.VarChar(13)
  deliveryLocationId           String?     @map("delivery_location_id") @db.Uuid
  deliveryAreaSnapshot         String?     @map("delivery_area_snapshot") @db.VarChar(120)
  deliveryLandmarkSnapshot     String?     @map("delivery_landmark_snapshot") @db.VarChar(240)
  deliveryPhoneSnapshot        String?     @map("delivery_phone_snapshot") @db.VarChar(13)
  deliveryInstructionsSnapshot String?     @map("delivery_instructions_snapshot") @db.VarChar(500)
  deliveryMapPinUrlSnapshot    String?     @map("delivery_map_pin_url_snapshot") @db.VarChar(2048)
  currency                     String?     @db.Char(3)
  subtotal                     BigInt      @default(0)
  idempotencyKey               String      @map("idempotency_key") @db.VarChar(128)
  requestHash                  String      @map("request_hash") @db.Char(64)
  createdAt                    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  abandonedAt                  DateTime?   @map("abandoned_at") @db.Timestamptz(3)
  cancelledAt                  DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  confirmedAt                  DateTime?   @map("confirmed_at") @db.Timestamptz(3)
  stockHoldExpiresAt           DateTime?   @map("stock_hold_expires_at") @db.Timestamptz(3)
  confirmationIdempotencyKey   String?     @map("confirmation_idempotency_key") @db.VarChar(128)
  confirmationRequestHash      String?     @map("confirmation_request_hash") @db.Char(64)

  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "orders_merchant_id_fkey")
  customer         Customer          @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Cascade, map: "orders_merchant_id_customer_id_fkey")
  deliveryLocation DeliveryLocation? @relation(fields: [merchantId, customerId, deliveryLocationId], references: [merchantId, customerId, id], onDelete: Restrict, onUpdate: Cascade, map: "orders_delivery_location_fkey")
  items            OrderItem[]

  @@unique([merchantId, id], map: "orders_merchant_id_id_key")
  @@unique([merchantId, idempotencyKey], map: "orders_merchant_id_idempotency_key_key")
  @@unique([merchantId, confirmationIdempotencyKey], map: "orders_merchant_confirmation_idempotency_key_key")
  @@index([merchantId, status, createdAt, id], map: "orders_merchant_status_created_id_idx")
  @@index([merchantId, customerId, createdAt, id], map: "orders_merchant_customer_created_id_idx")
  @@map("orders")
}

model OrderItem {
  id                  String   @id(map: "order_items_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId          String   @map("merchant_id") @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  variantId           String   @map("variant_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(160)
  skuSnapshot         String   @map("sku_snapshot") @db.VarChar(64)
  sizeSnapshot        String?  @map("size_snapshot") @db.VarChar(80)
  colourSnapshot      String?  @map("colour_snapshot") @db.VarChar(80)
  quantity            BigInt
  unitSellingPrice    BigInt   @map("unit_selling_price")
  currency            String   @db.Char(3)
  lineTotal           BigInt   @map("line_total")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "order_items_merchant_id_fkey")
  order      Order          @relation(fields: [merchantId, orderId], references: [merchantId, id], onDelete: Restrict, onUpdate: Cascade, map: "order_items_merchant_id_order_id_fkey")
  variant    ProductVariant @relation(fields: [merchantId, variantId], references: [merchantId, id], onDelete: Restrict, onUpdate: Cascade, map: "order_items_merchant_id_variant_id_fkey")
  stockHolds StockHold[]

  @@unique([merchantId, id], map: "order_items_merchant_id_id_key")
  @@unique([merchantId, orderId, variantId], map: "order_items_merchant_order_variant_key")
  @@index([merchantId, orderId], map: "order_items_merchant_order_idx")
  @@index([merchantId, variantId], map: "order_items_merchant_variant_idx")
  @@map("order_items")
}

model InventoryBalance {
  merchantId String         @map("merchant_id") @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  state      InventoryState
  quantity   BigInt         @default(0)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "inventory_balances_merchant_id_fkey")
  variant  ProductVariant @relation(fields: [merchantId, variantId], references: [merchantId, id], onDelete: Restrict, onUpdate: Cascade, map: "inventory_balances_merchant_id_variant_id_fkey")

  @@id([merchantId, variantId, state], map: "inventory_balances_pkey")
  @@map("inventory_balances")
}

model InventoryLedgerEntry {
  id                    String                @id(map: "inventory_ledger_entries_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId            String                @map("merchant_id") @db.Uuid
  variantId             String                @map("variant_id") @db.Uuid
  type                  InventoryMovementType
  fromState             InventoryState?       @map("from_state")
  toState               InventoryState?       @map("to_state")
  quantity              BigInt
  fromStateBalanceAfter BigInt?               @map("from_state_balance_after")
  toStateBalanceAfter   BigInt?               @map("to_state_balance_after")
  note                  String?               @db.VarChar(500)
  idempotencyKey        String                @map("idempotency_key") @db.VarChar(128)
  requestHash           String                @map("request_hash") @db.Char(64)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "inventory_ledger_entries_merchant_id_fkey")
  variant  ProductVariant @relation(fields: [merchantId, variantId], references: [merchantId, id], onDelete: Restrict, onUpdate: Cascade, map: "inventory_ledger_entries_merchant_id_variant_id_fkey")

  @@unique([merchantId, id], map: "inventory_ledger_entries_merchant_id_id_key")
  @@unique([merchantId, idempotencyKey], map: "inventory_ledger_entries_merchant_id_idempotency_key_key")
  @@index([merchantId, variantId, createdAt, id], map: "inventory_ledger_variant_created_id_idx")
  @@index([merchantId, variantId, type, createdAt, id], map: "inventory_ledger_variant_type_created_id_idx")
  @@map("inventory_ledger_entries")
}

model StockHold {
  id             String          @id(map: "stock_holds_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId     String          @map("merchant_id") @db.Uuid
  variantId      String          @map("variant_id") @db.Uuid
  orderItemId    String?         @map("order_item_id") @db.Uuid
  quantity       BigInt
  status         StockHoldStatus @default(ACTIVE)
  expiresAt      DateTime        @map("expires_at") @db.Timestamptz(3)
  releasedAt     DateTime?       @map("released_at") @db.Timestamptz(3)
  expiredAt      DateTime?       @map("expired_at") @db.Timestamptz(3)
  idempotencyKey String          @map("idempotency_key") @db.VarChar(128)
  requestHash    String          @map("request_hash") @db.Char(64)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant  Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "stock_holds_merchant_id_fkey")
  variant   ProductVariant @relation(fields: [merchantId, variantId], references: [merchantId, id], onDelete: Restrict, onUpdate: Cascade, map: "stock_holds_merchant_id_variant_id_fkey")
  orderItem OrderItem?     @relation(fields: [merchantId, orderItemId], references: [merchantId, id], onDelete: Restrict, onUpdate: Cascade, map: "stock_holds_merchant_id_order_item_id_fkey")

  @@unique([merchantId, id], map: "stock_holds_merchant_id_id_key")
  @@unique([merchantId, idempotencyKey], map: "stock_holds_merchant_id_idempotency_key_key")
  @@index([merchantId, variantId, status, expiresAt], map: "stock_holds_merchant_variant_status_expiry_idx")
  @@index([merchantId, orderItemId], map: "stock_holds_merchant_order_item_idx")
  @@index([status, expiresAt], map: "stock_holds_status_expiry_idx")
  @@map("stock_holds")
}

model VariantPriceHistory {
  id           String   @id(map: "variant_price_history_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId   String   @map("merchant_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  sellingPrice BigInt   @map("selling_price")
  costPrice    BigInt?  @map("cost_price")
  currency     String   @db.Char(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [merchantId, variantId], references: [merchantId, id], onDelete: Restrict, onUpdate: Cascade, map: "variant_price_history_merchant_id_variant_id_fkey")

  @@index([merchantId, variantId, createdAt, id], map: "variant_price_history_merchant_id_variant_id_created_at_id_idx")
  @@map("variant_price_history")
}

model User {
  id          String     @id(map: "users_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  displayName String     @map("display_name") @db.VarChar(160)
  phoneE164   String     @unique(map: "users_phone_e164_key") @map("phone_e164") @db.VarChar(16)
  email       String?    @unique(map: "users_email_key") @db.VarChar(320)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        MerchantMembership[]
  passwordCredential PasswordCredential?
  sessions           Session[]

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Session {
  id         String    @id(map: "sessions_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "sessions_user_id_fkey")

  @@index([userId, revokedAt, expiresAt], map: "sessions_user_id_revoked_at_expires_at_idx")
  @@map("sessions")
}

model PasswordCredential {
  id                String   @id(map: "password_credentials_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String   @unique(map: "password_credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(512)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "password_credentials_user_id_fkey")

  @@map("password_credentials")
}

model MerchantMembership {
  id         String                   @id(map: "merchant_memberships_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId String                   @map("merchant_id") @db.Uuid
  userId     String                   @map("user_id") @db.Uuid
  status     MerchantMembershipStatus @default(ACTIVE)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "merchant_memberships_merchant_id_fkey")
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "merchant_memberships_user_id_fkey")
  membershipRoles MembershipRole[]

  @@unique([merchantId, userId], map: "merchant_memberships_merchant_id_user_id_key")
  @@unique([merchantId, id], map: "merchant_memberships_merchant_id_id_key")
  @@index([merchantId, status], map: "merchant_memberships_merchant_id_status_idx")
  @@index([userId, status], map: "merchant_memberships_user_id_status_idx")
  @@map("merchant_memberships")
}

model Permission {
  id          String           @id(map: "permissions_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String           @unique(map: "permissions_key_key") @db.VarChar(120)
  description String?          @db.VarChar(320)
  status      PermissionStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@index([status], map: "permissions_status_idx")
  @@map("permissions")
}

model Role {
  id          String     @id(map: "roles_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId  String     @map("merchant_id") @db.Uuid
  name        String     @db.VarChar(80)
  description String?    @db.VarChar(320)
  status      RoleStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "roles_merchant_id_fkey")
  membershipRoles MembershipRole[]
  rolePermissions RolePermission[]

  @@unique([merchantId, name], map: "roles_merchant_id_name_key")
  @@unique([merchantId, id], map: "roles_merchant_id_id_key")
  @@index([merchantId, status], map: "roles_merchant_id_status_idx")
  @@map("roles")
}

model MembershipRole {
  id           String   @id(map: "membership_roles_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId   String   @map("merchant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership MerchantMembership @relation(fields: [merchantId, membershipId], references: [merchantId, id], onDelete: Cascade, onUpdate: Cascade, map: "membership_roles_merchant_id_membership_id_fkey")
  role       Role               @relation(fields: [merchantId, roleId], references: [merchantId, id], onDelete: Cascade, onUpdate: Cascade, map: "membership_roles_merchant_id_role_id_fkey")

  @@unique([membershipId, roleId], map: "membership_roles_membership_id_role_id_key")
  @@index([merchantId, roleId], map: "membership_roles_merchant_id_role_id_idx")
  @@map("membership_roles")
}

model RolePermission {
  id           String   @id(map: "role_permissions_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId   String   @map("merchant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [merchantId, roleId], references: [merchantId, id], onDelete: Cascade, onUpdate: Cascade, map: "role_permissions_merchant_id_role_id_fkey")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "role_permissions_permission_id_fkey")

  @@unique([roleId, permissionId], map: "role_permissions_role_id_permission_id_key")
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}
