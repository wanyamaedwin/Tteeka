generator client {
  provider     = "prisma-client"
  output       = "../packages/database/src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("merchant_status")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MerchantMembershipStatus {
  ACTIVE
  DISABLED

  @@map("merchant_membership_status")
}

enum PermissionStatus {
  ACTIVE
  DEPRECATED

  @@map("permission_status")
}

enum RoleStatus {
  ACTIVE
  DISABLED

  @@map("role_status")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("product_status")
}

model Merchant {
  id          String         @id(map: "merchants_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  displayName String         @map("display_name") @db.VarChar(160)
  legalName   String?        @map("legal_name") @db.VarChar(200)
  phoneE164   String?        @map("phone_e164") @db.VarChar(16)
  email       String?        @db.VarChar(320)
  currency    String         @default("UGX") @db.Char(3)
  timezone    String         @default("Africa/Kampala") @db.VarChar(64)
  status      MerchantStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships MerchantMembership[]
  roles       Role[]
  products    Product[]

  @@index([status], map: "merchants_status_idx")
  @@map("merchants")
}

model Product {
  id          String        @id(map: "products_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId  String        @map("merchant_id") @db.Uuid
  name        String        @db.VarChar(160)
  description String?       @db.VarChar(2000)
  category    String?       @db.VarChar(120)
  brand       String?       @db.VarChar(120)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "products_merchant_id_fkey")

  @@index([merchantId, status], map: "products_merchant_id_status_idx")
  @@index([merchantId, name], map: "products_merchant_id_name_idx")
  @@index([merchantId, category], map: "products_merchant_id_category_idx")
  @@index([merchantId, brand], map: "products_merchant_id_brand_idx")
  @@map("products")
}

model User {
  id          String     @id(map: "users_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  displayName String     @map("display_name") @db.VarChar(160)
  phoneE164   String     @unique(map: "users_phone_e164_key") @map("phone_e164") @db.VarChar(16)
  email       String?    @unique(map: "users_email_key") @db.VarChar(320)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        MerchantMembership[]
  passwordCredential PasswordCredential?
  sessions           Session[]

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Session {
  id         String    @id(map: "sessions_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "sessions_user_id_fkey")

  @@index([userId, revokedAt, expiresAt], map: "sessions_user_id_revoked_at_expires_at_idx")
  @@map("sessions")
}

model PasswordCredential {
  id                String   @id(map: "password_credentials_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String   @unique(map: "password_credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(512)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "password_credentials_user_id_fkey")

  @@map("password_credentials")
}

model MerchantMembership {
  id         String                   @id(map: "merchant_memberships_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId String                   @map("merchant_id") @db.Uuid
  userId     String                   @map("user_id") @db.Uuid
  status     MerchantMembershipStatus @default(ACTIVE)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "merchant_memberships_merchant_id_fkey")
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "merchant_memberships_user_id_fkey")
  membershipRoles MembershipRole[]

  @@unique([merchantId, userId], map: "merchant_memberships_merchant_id_user_id_key")
  @@unique([merchantId, id], map: "merchant_memberships_merchant_id_id_key")
  @@index([merchantId, status], map: "merchant_memberships_merchant_id_status_idx")
  @@index([userId, status], map: "merchant_memberships_user_id_status_idx")
  @@map("merchant_memberships")
}

model Permission {
  id          String           @id(map: "permissions_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String           @unique(map: "permissions_key_key") @db.VarChar(120)
  description String?          @db.VarChar(320)
  status      PermissionStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@index([status], map: "permissions_status_idx")
  @@map("permissions")
}

model Role {
  id          String     @id(map: "roles_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId  String     @map("merchant_id") @db.Uuid
  name        String     @db.VarChar(80)
  description String?    @db.VarChar(320)
  status      RoleStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "roles_merchant_id_fkey")
  membershipRoles MembershipRole[]
  rolePermissions RolePermission[]

  @@unique([merchantId, name], map: "roles_merchant_id_name_key")
  @@unique([merchantId, id], map: "roles_merchant_id_id_key")
  @@index([merchantId, status], map: "roles_merchant_id_status_idx")
  @@map("roles")
}

model MembershipRole {
  id           String   @id(map: "membership_roles_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId   String   @map("merchant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership MerchantMembership @relation(fields: [merchantId, membershipId], references: [merchantId, id], onDelete: Cascade, onUpdate: Cascade, map: "membership_roles_merchant_id_membership_id_fkey")
  role       Role               @relation(fields: [merchantId, roleId], references: [merchantId, id], onDelete: Cascade, onUpdate: Cascade, map: "membership_roles_merchant_id_role_id_fkey")

  @@unique([membershipId, roleId], map: "membership_roles_membership_id_role_id_key")
  @@index([merchantId, roleId], map: "membership_roles_merchant_id_role_id_idx")
  @@map("membership_roles")
}

model RolePermission {
  id           String   @id(map: "role_permissions_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  merchantId   String   @map("merchant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [merchantId, roleId], references: [merchantId, id], onDelete: Cascade, onUpdate: Cascade, map: "role_permissions_merchant_id_role_id_fkey")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "role_permissions_permission_id_fkey")

  @@unique([roleId, permissionId], map: "role_permissions_role_id_permission_id_key")
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}
