{
  "name": "tteeka",
  "version": "0.0.0",
  "private": true,
  "description": "Uganda-first WhatsApp Commerce Operating System backend",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @tteeka/config && npm run build --workspace @tteeka/testing && npm run build --workspace @tteeka/api && npm run build --workspace @tteeka/worker",
    "dev:api": "npm run dev --workspace @tteeka/api",
    "dev:worker": "npm run dev --workspace @tteeka/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up -d --wait",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
