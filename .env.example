# Local development only. Copy this file to .env before starting Tteeka.

# Docker local infrastructure
POSTGRES_DB=tteeka
POSTGRES_USER=tteeka
POSTGRES_PASSWORD=tteeka_local_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379

# Tteeka application
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://tteeka:tteeka_local_dev_only@127.0.0.1:5432/tteeka
REDIS_URL=redis://127.0.0.1:6379
INFRA_HEALTH_TIMEOUT_MS=2000
SESSION_TTL_SECONDS=43200
SESSION_TOUCH_INTERVAL_SECONDS=300

# MTN MoMo Collections sandbox transport (disabled unless explicitly enabled)
MTN_MOMO_COLLECTIONS_ENABLED=false
MTN_MOMO_COLLECTIONS_API_USER=
MTN_MOMO_COLLECTIONS_API_KEY=
MTN_MOMO_COLLECTIONS_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTIONS_CALLBACK_URL=
MTN_MOMO_COLLECTIONS_TIMEOUT_MS=10000

# Explicit synthetic values for the developer-only sandbox smoke command
MTN_MOMO_SANDBOX_MSISDN=
MTN_MOMO_SANDBOX_AMOUNT=
MTN_MOMO_SANDBOX_EXTERNAL_ID=
MTN_MOMO_SANDBOX_PAYER_MESSAGE=
MTN_MOMO_SANDBOX_PAYEE_NOTE=
MTN_MOMO_SANDBOX_REFERENCE_ID=
